# Copy this file to .env and adjust as needed.
# Do not commit .env.

APP_ENV=development

# Provider-independent LLM settings. Current implementation: ollama.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://127.0.0.1:11434

# Local data directory (created later when features need it).
DATA_DIR=./data
