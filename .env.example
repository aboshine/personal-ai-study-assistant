# Copy this file to .env and adjust as needed.
# Do not commit .env.

APP_ENV=development

# Provider-independent LLM settings. Current implementation: ollama.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://127.0.0.1:11434

# Provider-independent embedding settings. Current implementation: ollama.
# Uses LLM_BASE_URL as the Ollama host. Pull the model with: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Local data directory (created later when features need it).
DATA_DIR=./data
