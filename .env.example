# Copy this file to .env and adjust as needed.
# Do not commit .env.

APP_ENV=development

# Provider-independent LLM settings. Current implementation: ollama.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://127.0.0.1:11434

# Local embeddings (Ollama /api/embed). Reuses LLM_BASE_URL.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Local data directory for SQLite stores and uploaded PDFs.
DATA_DIR=./data

# SQLite vector store path. Relative paths are resolved from the project root.
# If unset, defaults to DATA_DIR/vector_store.sqlite.
VECTOR_STORE_PATH=./data/vector_store.sqlite

# SQLite quiz attempt history path. Relative paths are resolved from the project root.
# If unset, defaults to DATA_DIR/quiz_attempts.sqlite.
QUIZ_ATTEMPT_STORE_PATH=./data/quiz_attempts.sqlite

# SQLite study-plan store path. Relative paths are resolved from the project root.
# If unset, defaults to DATA_DIR/study_plans.sqlite.
STUDY_PLAN_STORE_PATH=./data/study_plans.sqlite
